generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  PATIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SpecialtyStatus {
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
}

enum AppointmentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
}

enum AppointmentActor {
  PATIENT
  DOCTOR
  ADMIN
  SYSTEM
}

enum DoctorScheduleOverrideType {
  AVAILABLE
  UNAVAILABLE
}

enum DoctorReviewStatus {
  PUBLISHED
  HIDDEN
}

enum AppointmentNotificationType {
  REQUEST_CREATED
  REQUEST_CONFIRMED
  REQUEST_REJECTED
  REQUEST_EXPIRED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  DOCTOR_NO_SHOW
  REMINDER_1_HOUR
  REMINDER_15_MINUTES
}

enum NotificationChannel {
  PUSH
  SMS
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum PushDevicePlatform {
  WEB
  ANDROID
  IOS
}

model User {
  id     String     @id @default(cuid())
  role   UserRole
  status UserStatus @default(ACTIVE)

  phone        String? @unique
  email        String? @unique
  passwordHash String?

  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  refreshTokens  RefreshToken[]

  appointmentStatusChanges AppointmentStatusHistory[] @relation("AppointmentStatusChangedBy")
  scheduleOverridesCreated DoctorScheduleOverride[]   @relation("ScheduleOverrideCreatedBy")
  appointmentNotifications AppointmentNotification[]  @relation("AppointmentNotificationRecipient")
  pushDeviceTokens         PushDeviceToken[]
  doctorReviewsModerated   DoctorReview[]               @relation("DoctorReviewModeratedBy")

  @@index([role, status])
}

model PatientProfile {
  userID         String   @id
  fullName       String
  dateOfBirth    DateTime
  gender         Gender   @default(UNSPECIFIED)
  address        String?
  medicalHistory String?
  drugAllergies  String?
  avatar         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userID], references: [id])

  doctorReviews    DoctorReview[]
  appointments     Appointment[]                @relation("PatientAppointments")
  slotReservations AppointmentSlotReservation[]
}

model DoctorProfile {
  userID            String   @id
  fullName          String
  yearsOfExperience Int      @default(0)
  qualifications    String[]
  avatarUrl         String
  bio               String
  weeklySchedule    Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User           @relation(fields: [userID], references: [id], onDelete: Cascade)
  specialties Specialty[]
  reviews     DoctorReview[]

  appointments      Appointment[]                @relation("DoctorAppointments")
  scheduleOverrides DoctorScheduleOverride[]
  slotReservations  AppointmentSlotReservation[]

  @@index([fullName])
}

model DoctorReview {
  id            String             @id @default(cuid())
  doctorID      String
  patientID     String
  rating        Int
  comment       String?
  doctorReply   String?
  repliedAt     DateTime?
  status        DoctorReviewStatus @default(PUBLISHED)
  hiddenReason  String?
  moderatedByID String?
  moderatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor      DoctorProfile  @relation(fields: [doctorID], references: [userID], onDelete: Cascade)
  patient     PatientProfile @relation(fields: [patientID], references: [userID], onDelete: Cascade)
  moderatedBy User?          @relation("DoctorReviewModeratedBy", fields: [moderatedByID], references: [id], onDelete: SetNull)

  @@index([doctorID, status, rating, createdAt])
  @@unique([doctorID, patientID])
  @@index([patientID, createdAt])
  @@index([status, createdAt])
}

model Appointment {
  id        String @id @default(cuid())
  doctorID  String
  patientID String

  startAt DateTime
  endAt   DateTime

  visitReason             String
  status                  AppointmentStatus @default(PENDING_CONFIRMATION)
  confirmationDueAt       DateTime
  rejectionReason         String?
  cancellationReason      String?
  cancelledBy             AppointmentActor?
  respondedAt             DateTime?
  cancelledAt             DateTime?
  completedAt             DateTime?
  noShowAt                DateTime?
  meetingUrl              String?
  meetingSpaceName        String?
  meetingCreatedAt        DateTime?
  meetingClosedAt         DateTime?
  meetingCleanupPending   Boolean           @default(false)
  meetingCleanupAttempts  Int               @default(0)
  meetingCleanupLastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor          DoctorProfile               @relation("DoctorAppointments", fields: [doctorID], references: [userID], onDelete: Restrict)
  patient         PatientProfile              @relation("PatientAppointments", fields: [patientID], references: [userID], onDelete: Restrict)
  slotReservation AppointmentSlotReservation?
  statusHistory   AppointmentStatusHistory[]
  notifications   AppointmentNotification[]

  @@index([doctorID, startAt, status])
  @@index([patientID, startAt, status])
  @@index([status, confirmationDueAt])
  @@index([status, endAt])
  @@index([meetingCleanupPending, updatedAt])
}

model AppointmentSlotReservation {
  id            String    @id @default(cuid())
  appointmentID String    @unique
  doctorID      String
  patientID     String
  startAt       DateTime
  endAt         DateTime
  expiresAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment    @relation(fields: [appointmentID], references: [id], onDelete: Cascade)
  doctor      DoctorProfile  @relation(fields: [doctorID], references: [userID], onDelete: Cascade)
  patient     PatientProfile @relation(fields: [patientID], references: [userID], onDelete: Cascade)

  @@unique([doctorID, startAt])
  @@unique([patientID, startAt])
  @@index([expiresAt])
}

model DoctorScheduleOverride {
  id          String                     @id @default(cuid())
  doctorID    String
  createdByID String?
  type        DoctorScheduleOverrideType
  startAt     DateTime
  endAt       DateTime
  reason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor    DoctorProfile @relation(fields: [doctorID], references: [userID], onDelete: Cascade)
  createdBy User?         @relation("ScheduleOverrideCreatedBy", fields: [createdByID], references: [id], onDelete: SetNull)

  @@index([doctorID, startAt, endAt, type])
}

model AppointmentStatusHistory {
  id            String             @id @default(cuid())
  appointmentID String
  changedByID   String?
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  actor         AppointmentActor
  note          String?
  createdAt     DateTime           @default(now())

  appointment Appointment @relation(fields: [appointmentID], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("AppointmentStatusChangedBy", fields: [changedByID], references: [id], onDelete: SetNull)

  @@index([appointmentID, createdAt])
}

model AppointmentNotification {
  id                  String                      @id @default(cuid())
  appointmentID       String
  recipientID         String
  type                AppointmentNotificationType
  channel             NotificationChannel
  status              NotificationDeliveryStatus  @default(PENDING)
  scheduledAt         DateTime
  nextAttemptAt       DateTime?
  processingStartedAt DateTime?
  sentAt              DateTime?
  attempts            Int                         @default(0)
  failureReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentID], references: [id], onDelete: Cascade)
  recipient   User        @relation("AppointmentNotificationRecipient", fields: [recipientID], references: [id], onDelete: Cascade)

  @@unique([appointmentID, recipientID, type, channel])
  @@index([status, scheduledAt])
  @@index([status, nextAttemptAt])
}

model PushDeviceToken {
  id       String             @id @default(cuid())
  userID   String
  token    String             @unique
  platform PushDevicePlatform
  enabled  Boolean            @default(true)

  lastRegisteredAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID, enabled])
}

model Specialty {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String          @unique
  description String?
  status      SpecialtyStatus @default(ACTIVE)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors DoctorProfile[]

  @@index([status, name])
}

model OtpCode {
  id          String     @id @default(cuid())
  phoneNumber String     @unique
  purpose     OtpPurpose

  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  payloadJson Json?
  createdAt   DateTime @default(now())

  @@index([phoneNumber, purpose, createdAt])
}

model RefreshToken {
  id         String  @id @default(cuid())
  userId     String
  jti        String  @unique
  tokenHash  String  @unique
  deviceInfo String?

  expiresAt    DateTime
  revokedAt    DateTime?
  replacedByID String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
}
